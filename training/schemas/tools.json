              "feedback",
              "project",
              "reference"
            ]
          },
          "content": {
            "type": "string"
          },
          "scope": {
            "type": "string",
            "enum": [
              "project",
              "global"
            ],
            "description": "project (default) or global"
          }
        },
        "required": [
          "name",
          "description",
          "type",
          "content"
        ],
        "additionalProperties": false
      }
    }
